# MySQL container configuration
MYSQL_DATABASE=wod_explorer
MYSQL_USER=wod_user
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local

# Backend configuration when running outside Docker
DB_URL=jdbc:mysql://localhost:3307/wod_explorer
DB_USER=wod_user
DB_PASSWORD=change-me-local

# JWT signing configuration
JWT_SECRET=change-me-use-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=3600000

# Allowed browser origin and frontend API base URL
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

# Comma-separated emails allowed to mutate the exercise catalog
ADMIN_EMAILS=
